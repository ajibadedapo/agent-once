{
  "name": "agent-once",
  "version": "0.1.0",
  "description": "Stop your AI agent from charging, booking or sending twice.",
  "keywords": [
    "idempotency",
    "exactly-once",
    "double-charge",
    "fault-injection",
    "chaos-engineering",
    "browser-agent",
    "computer-use",
    "mcp",
    "agent-testing",
    "mcp-proxy",
    "playwright-mcp",
    "ai-agents"
  ],
  "license": "Apache-2.0",
  "author": "Hammed Ajibade",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajibadedapo/agent-once.git",
    "directory": "packages/agent-once"
  },
  "homepage": "https://github.com/ajibadedapo/agent-once",
  "bugs": {
    "url": "https://github.com/ajibadedapo/agent-once/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agent-once": "dist/cli/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./chaos": {
      "types": "./dist/chaos/index.d.ts",
      "default": "./dist/chaos/index.js"
    },
    "./claude-agent-sdk": {
      "types": "./dist/integrations/claude-agent-sdk.d.ts",
      "default": "./dist/integrations/claude-agent-sdk.js"
    },
    "./playwright-mcp": {
      "types": "./dist/integrations/playwright-mcp.d.ts",
      "default": "./dist/integrations/playwright-mcp.js"
    },
    "./vitest": {
      "types": "./dist/integrations/vitest.d.ts",
      "default": "./dist/integrations/vitest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build && node scripts/prepack.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pretest:browser": "node scripts/check-chromium.mjs",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@opentelemetry/api": "^1.9.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.316",
    "@playwright/mcp": "0.0.83",
    "zod": "4.6.7"
  }
}
